// Массивы: литералы, push/pop, перебор, вложенные массивы.
import "std/arrays";

fn main() {
    var primes: [int] = [];
    var n = 2;
    while primes.len() < 10 {
        var prime = true;
        for p in primes {
            if n % p == 0 {
                prime = false;
                break;
            }
        }
        if prime {
            primes.push(n);
        }
        n += 1;
    }
    println("простые: {to_str(primes)}");
    println("сумма: {sum(primes)}, последнее: {primes[primes.len() - 1]}");

    // [значение; количество] — массив из одинаковых элементов
    var counts = [0; 10];
    for d in [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5] {
        counts[d] += 1;
    }
    println("частоты цифр: {to_str(counts)}");

    let data = [42, 7, 19, 3, 88, 21];
    sort(data);
    println("отсортировано: {to_str(data)}");
    println("чётные квадраты: {to_str(map(filter(data, fn(x: int) -> bool { x % 2 == 0 }), fn(x: int) -> int { x * x }))}");

    // таблица умножения как массив массивов
    var table: [[int]] = [];
    for i in 1..=3 {
        var row: [int] = [];
        for j in 1..=3 {
            row.push(i * j);
        }
        table.push(row);
    }
    for row in table {
        println(to_str(row));
    }
}
