// Ввод с клавиатуры.
//
//     echo -e "Анна\n7" | orbitron run examples/10_input.ot
import "std/io";

fn main() {
    let name = input("Как вас зовут? ");
    print("Сколько чисел Фибоначчи вывести? ");
    let n = read_int();
    println("{name}, держите:");
    var a = 0;
    var b = 1;
    for i in 0..n {
        print("{a} ");
        let t = a + b;
        a = b;
        b = t;
    }
    println();
}
